generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String?
  googleId     String? @unique
  name         String

  // Settings
  displayCurrency String @default("USD")
  timezone        String @default("UTC")

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  accounts          Account[]
  categories        Category[]
  transactions      Transaction[]
  groupMembers      GroupMember[]
  splitPayers       SplitPayer[]
  splitParticipants SplitParticipant[]
}

model Account {
  id       String      @id @default(uuid())
  userId   String
  name     String
  type     String      // Was AccountType enum
  currency String? // null means use user's default currency
  balance  Float       @default(0.0) // simplified to Float for now, Decimal might be better for prod

  // Optional meta-data (like credit card due date, etc.) can be stored in JSON or relations
  // metadata Json? // SQLite doesn't natively support JSON but Prisma maps it to Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model Category {
  id     String          @id @default(uuid())
  userId String? // null if it's a system default category
  name   String
  type   String // Was TransactionType // income, expense, transfer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id])
  transactions Transaction[]
}


model Transaction {
  id          String          @id @default(uuid())
  userId      String
  accountId   String
  categoryId  String?
  type        String // Was TransactionType
  amount      Float
  dateTime    DateTime
  tags        String?
  notes       String?
  attachments String? // serialized json array of file URLs

  // Future Splitwise support fields can be added here

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  account  Account   @relation(fields: [accountId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
}

model Group {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       GroupMember[]
  splitExpenses SplitExpense[]
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}


model SplitExpense {
  id          String    @id @default(uuid())
  groupId     String? // null means 1-on-1 or ad-hoc
  description String
  totalAmount Float
  splitType   String // Was SplitType
  date        DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group        Group?             @relation(fields: [groupId], references: [id])
  payers       SplitPayer[]
  participants SplitParticipant[]
}

model SplitPayer {
  id             String @id @default(uuid())
  splitExpenseId String
  userId         String
  amountPaid     Float

  splitExpense SplitExpense @relation(fields: [splitExpenseId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
}

model SplitParticipant {
  id             String @id @default(uuid())
  splitExpenseId String
  userId         String
  shareValue     Float? // Depends on splitType (e.g. 50%, 2 shares)
  amountOwed     Float // The calculated exact amount this user owes

  splitExpense SplitExpense @relation(fields: [splitExpenseId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
}

